APP_NAME=G-nom
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US


#######################
# G-nom feature flags #
#######################
GNOM_PUBLIC=true
GNOM_READONLY=normal
GNOM_SPARQL_CONSOLE=enabled
GNOM_WIKIDATA=enabled
GNOM_REGISTRATION_ENABLED=false

####################
# AI feature flags #
####################
GNOM_AGENTS_ENABLED=
GNOM_AGENTS=
GROBID_URL=
GNOM_STORE_DOCUMENTS=
GNOM_MCP_ENABLED=

AI_PROVIDER=
AI_TOOL_ROUTING_PROVIDER=
AI_TOOL_ROUTING_MODEL=

#########
# BLAST #
#########
GNOM_BLAST=enabled
SHARD_SIZE=20

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=laravel

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_DRIVER=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"


################
# Broadcasting #
################
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=268877
REVERB_APP_KEY=changeme
REVERB_APP_SECRET=changeme
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Laravel -> reverb
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# Frontend -> reverb
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Frontend customization
VITE_BASE_URL="${APP_URL}"
VITE_CUSTOM_LOGO=
VITE_CUSTOM_TITLE="G-nom"

QLEVER_HOST=http://qlever:8888
QLEVER_ACCESS_TOKEN=TOKEN




#######################
# LDAP Authentication #
#######################

# REQUIRED
LDAP_ENABLED=false
LDAP_LOGIN_BANNER="Login with LDAP"
LDAP_URI=
LDAP_BASE_DN=

# OPTIONAL: When using a dedicated service account for binding, set the credentials here
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=

# Transport security
# Set to true when using STARTTLS, not required when using ldaps://
# DANGER: If you're usinf ldap:// and LDAP_START_TLS=true is set, passwords will pass the network unencrypted!
LDAP_START_TLS=true
LDAP_VERIFY_CERT=
# OPTIONAL: Path to custom CA bundle
LDAP_CA_CERT=
LDAP_TIMEOUT=

# OPTIONAL: Attribute mapping if your LDAP deviates from common field names
LDAP_USERNAME_ATTR=uid
LDAP_EMAIL_ATTR=mail
LDAP_NAME_ATTR=cn

# OPTIONAL: Advanced filters
LDAP_USER_FILTER=
LDAP_REQUIRED_GROUP=
LDAP_GROUP_MODE=memberof
